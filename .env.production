# Copiar a .env.production y completar los campos vacios antes de desplegar.
# Selecciona este archivo para Compose, la API, el worker y el diagnostico SUNAT.
COMPROBANTES_ENV_FILE=.env.production
NODE_ENV=production
HOST=0.0.0.0
PORT=4005
# URL publica del frontend.
APP_ORIGIN=

# Conexion y esquema entregados por el DBA.
DB_DRIVER=postgres
DATABASE_URL=
DB_SCHEMA=comprobantes
# Ajustar segun la conexion proporcionada por el DBA.
DB_SSL=false
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000

DOCUMENT_DIRECTORY=./documentos
MAIL_MODE=smtp
MAIL_DIRECTORY=.local/correos
CALLBACK_DIRECTORY=.local/notificaciones
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Datos para el encabezado del PDF; el emisor fiscal sigue llegando en la compra.
PDF_ISSUER_NAME=
PDF_ISSUER_ADDRESS=

SUNAT_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
SUNAT_TIMEOUT_MS=30000
SUNAT_USERNAME=
SUNAT_PASSWORD=
SUNAT_SERIE_FACTURA=
SUNAT_SERIE_BOLETA=
SUNAT_CODIGO_LOCAL=
# Rutas accesibles al proceso; en Docker deben ser rutas dentro del contenedor.
SUNAT_CERTIFICATE_PATH=
SUNAT_PRIVATE_KEY_PATH=
SUNAT_AFECTACION_POR_DEFINIR=

INTEGRATION_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_HOURS=8

# No iniciar un segundo worker sobre la misma base sin planificar su concurrencia.
WORKERS_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5

# Completar ambos para notificar a Boletos por HTTP.
BOLETOS_CALLBACK_URL=
BOLETOS_CALLBACK_KEY=
