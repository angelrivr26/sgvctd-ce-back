# Plantilla sin valores. La aplicacion carga .env; complete alli su configuracion.
NODE_ENV=
HOST=
PORT=
APP_ORIGIN=

# El DBA crea el esquema con sql/001_esquema.sql y entrega estos datos.
DB_DRIVER=
DATABASE_URL=
DB_SCHEMA=
DB_SSL=
DB_POOL_MAX=
DB_CONNECT_TIMEOUT_MS=
DB_STATEMENT_TIMEOUT_MS=
DB_LOCK_TIMEOUT_MS=
# Solo para pruebas internas aisladas con DB_DRIVER=pglite.
DATA_DIRECTORY=

DOCUMENT_DIRECTORY=
MAIL_MODE=
MAIL_DIRECTORY=
CALLBACK_DIRECTORY=

# MAIL_MODE=capture guarda una evidencia JSON local y no contacta destinatarios.
# Para envio real use MAIL_MODE=smtp y complete todos los valores siguientes.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# jsPDF genera el archivo directamente en Node.js, sin navegador ni servicio externo.
# Datos publicos usados solo en el encabezado de la representacion PDF.
# No reemplazan al emisor fiscal recibido en el contrato ni modifican XML/CDR.
PDF_ISSUER_NAME=
PDF_ISSUER_ADDRESS=

# Complete estos valores antes de iniciar, tanto en local como en despliegue.
# El codigo no reemplaza variables faltantes por datos de prueba.
SUNAT_URL=
SUNAT_USERNAME=
SUNAT_PASSWORD=
SUNAT_SERIE_FACTURA=
SUNAT_SERIE_BOLETA=
SUNAT_CODIGO_LOCAL=
SUNAT_TIMEOUT_MS=

# Beta crea un certificado local si no se indican rutas.
SUNAT_CERTIFICATE_DIRECTORY=

# Produccion exige ademas certificado y clave privada institucionales.
SUNAT_CERTIFICATE_PATH=
SUNAT_PRIVATE_KEY_PATH=

# Solo usar durante una transicion si Boletos aun envia POR_DEFINIR.
# Vacio obliga a informar EXONERADO o INAFECTO en cada linea.
SUNAT_AFECTACION_POR_DEFINIR=

# npm run setup:local genera la clave y el hash para desarrollo.
INTEGRATION_API_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_HOURS=

# No ejecutar al mismo tiempo un worker local y otro desplegado sobre la misma base.
WORKERS_ENABLED=
WORKER_CONCURRENCY=
WORKER_INTERVAL_MS=
WORKER_LEASE_SECONDS=
WORKER_MAX_ATTEMPTS=

# Vacio captura callbacks en disco. Para integracion real configure ambos valores.
BOLETOS_CALLBACK_URL=
BOLETOS_CALLBACK_KEY=
