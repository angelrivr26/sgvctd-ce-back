NODE_ENV=development
HOST=127.0.0.1
PORT=4005
APP_ORIGIN=http://localhost:4205
DB_DRIVER=pglite
# PostgreSQL: puede compartir temporalmente la BD de Boletos en un esquema propio.
# DB_DRIVER=postgres
# DATABASE_URL=postgres://usuario:clave@localhost:5432/comprobantes_pruebas
# PostgreSQL usa comprobantes por defecto. Public se conserva solo para PGlite local existente.
# DB_SCHEMA=comprobantes
DB_SSL=false
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DATA_DIRECTORY=.local/data
DOCUMENT_DIRECTORY=.local/documentos
MAIL_DIRECTORY=.local/correos
CALLBACK_DIRECTORY=.local/notificaciones
FISCAL_PROVIDER=simulado
# Ambiente fiscal independiente de NODE_ENV. El circuito actual solo ejecuta beta.
SUNAT_ENV=beta
SUNAT_BETA_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PRODUCTION_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
SUNAT_TIMEOUT_MS=30000
# npm run setup:local genera claves aleatorias y hash de acceso.
INTEGRATION_API_KEY=
ADMIN_USERNAME=contador
ADMIN_PASSWORD_HASH=
SESSION_HOURS=8
WORKERS_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
# Vacio: capturar notificaciones localmente. No se modifican proyectos Boletos.
BOLETOS_CALLBACK_URL=
BOLETOS_CALLBACK_KEY=
