NODE_ENV=development
HOST=127.0.0.1
PORT=4005
APP_ORIGIN=http://localhost:4205

# El DBA crea el esquema con sql/001_esquema.sql y entrega estos datos.
DB_DRIVER=postgres
DATABASE_URL="postgresql://sgvboletos:$6VBdev26@10.10.14.172:5432/sgvcb?schema=comprobantes"
DB_SCHEMA=comprobantes
DB_SSL=false
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
# Solo para pruebas internas aisladas con DB_DRIVER=pglite.
DATA_DIRECTORY=.local/data

DOCUMENT_DIRECTORY=.local/documentos
MAIL_DIRECTORY=.local/correos
CALLBACK_DIRECTORY=.local/notificaciones

# Unico selector fiscal. Los endpoints oficiales estan definidos en src/config/sunat.js.
SUNAT_ENV=beta
SUNAT_TIMEOUT_MS=30000

# Beta crea un certificado local si no se indican rutas.
SUNAT_CERTIFICATE_DIRECTORY=.local/sunat/certificados

# Produccion exige credenciales, certificado institucional, series y codigo de local.
# SUNAT_USERNAME=20123456789USUARIO
# SUNAT_PASSWORD=
# SUNAT_CERTIFICATE_PATH=/ruta/certificado.pem
# SUNAT_PRIVATE_KEY_PATH=/ruta/clave-privada.pem
# SUNAT_SERIE_FACTURA=F001
# SUNAT_SERIE_BOLETA=B001
# SUNAT_CODIGO_LOCAL=0000

# Solo usar durante una transicion si Boletos aun envia POR_DEFINIR.
# Vacio obliga a informar EXONERADO o INAFECTO en cada linea.
SUNAT_AFECTACION_POR_DEFINIR=

# npm run setup:local genera la clave y el hash para desarrollo.
INTEGRATION_API_KEY=
ADMIN_USERNAME=contador
ADMIN_PASSWORD_HASH=
SESSION_HOURS=8

WORKERS_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5

# Vacio captura callbacks en disco. Para integracion real configure ambos valores.
BOLETOS_CALLBACK_URL=
BOLETOS_CALLBACK_KEY=
SUNAT_BETA_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PRODUCTION_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
